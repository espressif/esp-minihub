# Zigbee coordinator (esp-zigbee-lib 2.x native)
CONFIG_MINIHUB_ZIGBEE_SDK=n
CONFIG_ZB_ENABLED=y
# CONFIG_ZB_SDK_1xx is not set
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# Log level belongs to MINIHUB_RELEASE / menuconfig — do not pin INFO here
# (it fights CONFIG_MINIHUB_RELEASE's Warning select and sticks in sdkconfig).
