# Store + dynamic .mhub / elf_loader
CONFIG_MINIHUB_STORE=y
CONFIG_MINIHUB_DYNAMIC_MODULES=y
CONFIG_MINIHUB_ELF_PLUGINS=n
CONFIG_MINIHUB_JS_PLUGINS=y
# L2 MQTT dynamic discovery (host.mqtt) needs the bundled MQTT adapter.
CONFIG_MINIHUB_JS_MQTT=y
CONFIG_MINIHUB_MQTT_ADAPTER=y
CONFIG_ELF_LOADER=y
CONFIG_ELF_DYNAMIC_LOAD_SHARED_OBJECT=y
# L3 .so text/data in PSRAM (needs SPIRAM_XIP_FROM_PSRAM in memory.defaults).
CONFIG_ELF_LOADER_LOAD_PSRAM=y
CONFIG_ELF_FILE_SYSTEM_BASE_PATH="/data"
