menu "MCP"

    config MINIHUB_MCP_SERVER
        bool "Enable on-device MCP tool server (Hub tools for agents)"
        default y
        help
            Register MiniHub REST-equivalent tools via minihub_mcp_server.
            Requires ``git submodule update --init components/esp-claw``
            (cap_mcp_server). Used by idf_component.yml.

endmenu
