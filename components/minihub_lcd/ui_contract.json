      "parent": "/overview/overview_main/device_list",
      "instance_format": "dev_%d",
      "instance_prefix": "dev_",
      "count_key": "device_slots",
      "children": [
        "icon",
        "name",
        "type",
        "meta",
        "val",
        "power_sw",
        "delete_btn",
        "rename_btn"
      ],
      "action": "device_tap"
    },
    "DEVICE_PARAM_ROW": {
      "template_id": "device_param_row",
      "parent": "/overview/device_detail_modal/device_detail_card/device_detail_params",
      "instance_format": "param_%d",
      "instance_prefix": "param_",
      "count_key": "param_slots",
      "children": [
        "label",
        "sw",
        "sl_wrap",
        "sl",
        "sl_val",
        "dd",
        "btn",
        "ro"
      ],
      "action": "device_param_toggle"
    },

    "RULE_ROW": {
      "template_id": "rule_row",
      "parent": "/rules/rules_main/rules_list",
      "instance_format": "rule_%d",
      "instance_prefix": "rule_",
