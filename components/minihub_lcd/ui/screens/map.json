                "mode": "relative",
                "align": "center"
              },
              "style": {
                "textColor": "#8b9bb4"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "nav_store",
          "events": [
            {
              "type": "clicked",
              "action": "nav_store_from_map"
            }
          ],
          "style": {
            "bgColor": "#1a2238",
            "borderWidth": "1dp",
            "borderColor": "#243049"
          },
          "placement": {
            "width": "100dp",
            "height": "44dp"
          },
          "children": [
            {
              "type": "label",
              "id": "nav_store_lbl",
              "labelProps": {
                "text": "${constant.strings.nav_store}"
              },
              "placement": {
                "mode": "relative",
                "align": "center"
              },
              "style": {
                "textColor": "#8b9bb4"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "nav_system",
          "events": [
            {
              "type": "clicked",
              "action": "nav_system_from_map"
            }
          ],
          "style": {
            "bgColor": "#1a2238",
            "borderWidth": "1dp",
            "borderColor": "#243049"
          },
          "placement": {
            "width": "100dp",
            "height": "44dp"
          },
          "children": [
            {
              "type": "label",
              "id": "nav_system_lbl",
              "labelProps": {
                "text": "${constant.strings.nav_system}"
