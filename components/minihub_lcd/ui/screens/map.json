              "placement": {
                "mode": "relative",
                "align": "center"
              },
              "style": {
                "textColor": "#8b9bb4"
              }
            }
          ]
        },
        {
          "type": "container",
          "id": "sidebar_spacer",
          "placement": {
            "mode": "flow",
            "width": "wrap",
            "height": "wrap",
            "flexGrow": 1
          }
        },
        {
          "type": "button",
          "id": "user_btn",
          "events": [
            {
              "type": "clicked",
              "action": "user_tap_map"
