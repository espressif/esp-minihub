            "borderColor": "#243049"
          },
          "placement": {
            "width": "100dp",
            "height": "44dp"
          },
          "children": [
            {
              "type": "label",
              "id": "nav_rules_lbl",
              "labelProps": {
                "text": "${constant.strings.nav_rules}"
              },
              "placement": {
                "mode": "relative",
                "align": "center"
              },
              "style": {
                "textColor": "#8b9bb4"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "nav_scenes",
          "events": [
            {
              "type": "clicked",
              "action": "nav_scenes_from_map"
            }
          ],
          "style": {
            "bgColor": "#1a2238",
            "borderWidth": "1dp",
            "borderColor": "#243049"
          },
          "placement": {
            "width": "100dp",
            "height": "44dp"
          },
          "children": [
            {
              "type": "label",
              "id": "nav_scenes_lbl",
