{
  "type": "viewScreen",
  "id": "map",
  "mount_mode": "dynamic",
  "style": {
    "bgColor": "#0b0f1a",
    "padding": "0dp"
  },
  "children": [
    {
      "type": "container",
      "id": "sidebar",
      "layout": {
        "type": "flex",
        "flexFlow": "column",
        "mainAlign": "start",
        "crossAlign": "stretch",
        "gap": "6dp"
      },
      "placement": {
        "mode": "absolute",
        "x": "0dp",
        "y": "0dp",
        "width": "112dp",
        "height": "480dp"
      },
      "style": {
        "bgColor": "#0e1320",
        "borderWidth": "1dp",
        "borderColor": "#243049",
        "padding": "4dp"
      },
      "children": [
        {
          "type": "label",
          "id": "brand",
          "labelProps": {
            "text": "MiniHub"
          },
          "style": {
            "textColor": "#818cf8",
            "fontSize": "16sp"
          }
        },
        {
          "type": "button",
          "id": "nav_overview",
          "events": [
            {
              "type": "clicked",
              "action": "nav_overview_from_map"
            }
          ],
          "style": {
            "bgColor": "#1a2238",
            "borderWidth": "1dp",
            "borderColor": "#243049"
          },
          "placement": {
            "width": "100dp",
            "height": "44dp"
          },
          "children": [
            {
              "type": "label",
              "id": "nav_overview_lbl",
              "labelProps": {
                "text": "${constant.strings.nav_overview}"
              },
              "placement": {
                "mode": "relative",
                "align": "center"
              },
              "style": {
                "textColor": "#8b9bb4"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "nav_map",
          "style": {
            "bgColor": "#6366f1",
            "borderWidth": "1dp",
            "borderColor": "#6366f1"
          },
          "placement": {
            "width": "100dp",
            "height": "44dp"
          },
          "children": [
            {
              "type": "label",
              "id": "nav_map_lbl",
              "labelProps": {
                "text": "${constant.strings.nav_map}"
              },
              "placement": {
                "mode": "relative",
                "align": "center"
              },
              "style": {
                "textColor": "#eef2ff"
