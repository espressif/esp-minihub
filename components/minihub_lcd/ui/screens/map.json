    },
    {
      "type": "container",
      "id": "map_main",
      "layout": {
        "type": "flex",
        "flexFlow": "column",
        "mainAlign": "start",
        "crossAlign": "stretch",
        "gap": "10dp"
      },
      "placement": {
        "mode": "absolute",
        "x": "112dp",
        "y": "0dp",
        "width": "688dp",
        "height": "480dp"
      },
      "style": {
        "bgColor": "#0b0f1a",
        "padding": "12dp"
      },
      "children": [
        {
          "type": "label",
          "id": "map_title",
          "labelProps": {
            "text": "${constant.strings.nav_map}"
          },
          "style": {
            "textColor": "#eef2ff",
            "fontSize": "18sp"
          }
        },
        {
          "type": "label",
          "id": "map_hub",
          "labelProps": {
            "text": "Hub: locating..."
          },
          "style": {
            "textColor": "#8b9bb4",
            "fontSize": "13sp"
          }
        },
        {
          "type": "label",
          "id": "map_info",
          "labelProps": {
            "text": "Hub map (OpenStreetMap)"
          },
          "style": {
            "textColor": "#5c6b85",
            "fontSize": "12sp"
          }
        },
        {
          "type": "container",
          "id": "map_canvas_wrap",
          "placement": {
            "width": "664dp",
            "height": "316dp"
          },
          "style": {
            "bgColor": "#1a2238",
            "borderWidth": "1dp",
            "borderColor": "#243049",
            "radius": "10dp"
          },
          "children": [
            {
              "type": "image",
              "id": "map_image",
              "imageProps": {
                "src": "",
                "innerAlign": "stretch"
              },
              "placement": {
                "mode": "relative",
                "align": "center",
                "width": "664dp",
                "height": "316dp"
              },
              "style": {
                "bgColor": "#1a2238"
              }
            },
            {
              "type": "label",
              "id": "map_status",
              "labelProps": {
                "text": "Updating map..."
              },
              "placement": {
                "mode": "relative",
                "align": "center"
              },
              "style": {
                "textColor": "#8b9bb4",
                "fontSize": "14sp"
              },
              "commonProps": {
                "hidden": false
              }
            },
            {
              "type": "container",
              "id": "map_hub_marker",
              "placement": {
                "mode": "relative",
                "align": "center",
                "width": "14dp",
                "height": "14dp"
              },
              "style": {
                "bgColor": "#2196f3",
                "borderWidth": "2dp",
                "borderColor": "#ffffff",
                "radius": "7dp"
              }
            }
          ]
        }
