menu "Provisioning"

    config MINIHUB_WIFI_SSID
        string "WiFi SSID"
        default "YOUR_SSID"
        help
            Leave as YOUR_SSID to use NVS / SoftAP provisioning instead.

    config MINIHUB_WIFI_PASS
        string "WiFi Password"
        default "YOUR_PASSWORD"

    config MINIHUB_WIFI_PROVISIONING
        bool "Enable Wi-Fi provisioning when SSID not set"
        default y
        help
            When Kconfig/NVS have no Wi-Fi credentials, start provisioning.
            The only transport is SoftAP (no Bluetooth). The shipped Host serves
            its console on port 80, so minihub_net brings up a plain open AP
            instead of the network_provisioning HTTP server; a product that moves
            the console can call minihub_provision_start() to use the manager.

    config MINIHUB_FACTORY_RESET_BUTTON
        bool "BOOT button long-press factory reset (erase NVS)"
        default n

    config MINIHUB_FACTORY_RESET_GPIO
        int "Factory-reset button GPIO"
        depends on MINIHUB_FACTORY_RESET_BUTTON
        default 61
        range 0 61

    config MINIHUB_FACTORY_RESET_HOLD_MS
        int "Factory-reset hold time (ms)"
        depends on MINIHUB_FACTORY_RESET_BUTTON
        default 5000
        range 1000 30000

    config MINIHUB_FACTORY_RESET_ACTIVE_LOW
        bool "Factory-reset button is active low"
        depends on MINIHUB_FACTORY_RESET_BUTTON
        default y

endmenu
