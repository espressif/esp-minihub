menu "Web UI"

    config MINIHUB_WEB_UI
        bool "Enable Host Web UI (browser dashboard)"
        default y

    config MINIHUB_CUSTOM_WEB_SRC
        string "Custom Web console source directory"
        depends on MINIHUB_WEB_UI
        help
            Override the Web console source tree bundled into the storage
            image. Empty (default) uses components/minihub_web/web. Set a
            repo-relative path (e.g. application/myhub/web) or an absolute
            path to bundle an OEM skin instead of the in-tree console. The
            path must contain an index.html; the build fails otherwise.
            Resolved in application/<app>/main/CMakeLists.txt, which minifies
            the tree into /data/web/.

    config MINIHUB_MODULE_THIRD_PARTY_UI_WEB
        bool "Enable third-party module web UI pages"
        depends on MINIHUB_WEB_UI
        default y
        help
            Served at GET /modules/<id>/web/* when MINIHUB_WEB_UI is on.

    config MINIHUB_DEV_FS_UPLOAD
        bool "Allow HTTP PUT of LCD UI JSON files (dev)"
        default y
        help
            PUT /api/dev/fs/ui/... under /data/ui/. Consumed by LCD UI at boot;
            not a compile-time dependency on MINIHUB_LCD_UI.

    config MINIHUB_WEB_VERSION
        string "Web bundle version"
        default MINIHUB_VERSION
        help
            Version of the Web console bundle -- the only source of truth for it;
            do not hand-edit a version file in the source tree. Write it without
            the leading "v"; the folder name adds that as UI style. Everything
            else is derived:

            * tools/deploy.sh publishes Webs/v<version>/ and stamps the bundle.
            * application/<app>/main/CMakeLists.txt stamps the same value into
              the storage image when CONFIG_MINIHUB_WEB_UI is on.

            The stamp writes version.txt and window.mhWebVersion, which
            minihub_update reads to compare installed vs published, so both
            paths must produce one string. Kept separate from MINIHUB_VERSION
            because web and firmware releases are usually not in sync -- a
            web-only fix bumps this without touching the firmware.
            Defaults to MINIHUB_VERSION (defined in the MiniHub menu).

    choice MINIHUB_WEB_ASSET_ENCODING
        prompt "Web console files on storage"
        default MINIHUB_WEB_ASSET_GZIP
        depends on MINIHUB_WEB_UI
        help
            Controls which copies of Host Web JS/CSS/HTML/JSON land in /data/web/
            and how httpd serves them. Tiny markers (version.txt, release_notes.txt)
            and login.html always stay plain so the login page can inject auth state.

            Two practical modes (plus an optional both):

            * Gzip only (default) — compressible assets stored as .gz only
              (~0.13 MiB plus plain login.html). Clients must send
              Accept-Encoding: gzip or the request returns 406.
            * Plain only — no .gz siblings (~0.53 MiB). Every client reads plain.
            * Both — plain file plus a .gz sibling (~0.65 MiB). Clients that send
              Accept-Encoding: gzip get the compressed copy.

            Store publish (deploy.sh / pack_store_resources) writes parallel
            Webs/<ver>/plain/ and …/gzip/ trees (same relative paths; gzip side
            uses *.gz names). Upload either ZIP alone or both. OTA flattens onto
            /data/web/ and only pulls the tree this choice needs. A flash built
            here packs a flat /data/web layout for this mode only.

    config MINIHUB_WEB_ASSET_GZIP
        bool "Gzip only (Accept-Encoding: gzip required)"
    config MINIHUB_WEB_ASSET_PLAIN
        bool "Plain only"
    config MINIHUB_WEB_ASSET_BOTH
        bool "Plain and gzip (.gz siblings)"
    endchoice

    # Login / Bearer live with the console they protect (same httpd).
    rsource "../minihub_auth/Kconfig.minihub"

endmenu
