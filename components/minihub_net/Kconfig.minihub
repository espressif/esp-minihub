menu "Networking"

    config MINIHUB_NET_WIFI_STA
        bool "Enable Wi-Fi STA"
        default y
        help
            Start Wi-Fi station (credentials from Kconfig / NVS / SoftAP or BLE provision).

    config MINIHUB_NET_WIFI_SOFTAP
        bool "Wi-Fi SoftAP in use (external stack)"
        default n
        help
            Product uses 2.4 GHz Wi-Fi SoftAP and/or STA outside minihub_net
            while MINIHUB_NET_WIFI_STA is disabled. Set n for ETH-only Host.
            Enables RF coexistence hooks (esp_coex_wifi_i154) for Zigbee on S31.

    config MINIHUB_NET_ETH
        bool "Enable Ethernet (native EMAC)"
        depends on SOC_EMAC_SUPPORTED
        default y if IDF_TARGET_ESP32S31
        default n
        help
            Start native EMAC + PHY (ESP32-S31 Function CoreBoard: YT8531DC-CA RGMII).
            Mutually exclusive with MINIHUB_LCD_UI (EMAC and RGB LCD share pin groups
            on Korvo1; Function CoreBoard has RJ45 and no LCD). Enable ETH only when
            LCD UI is disabled (MINIHUB_LCD_UI depends on !MINIHUB_NET_ETH).

    config MINIHUB_NET_ETH_PHY_ADDR
        int "Ethernet PHY address (-1 = auto)"
        depends on MINIHUB_NET_ETH
        range -1 31
        default -1

    config MINIHUB_NET_ETH_PHY_RST_GPIO
        int "Ethernet PHY reset GPIO (-1 = unused)"
        depends on MINIHUB_NET_ETH
        range -1 63
        default 7 if IDF_TARGET_ESP32S31
        default -1

    config MINIHUB_NET_ETH_YT8531_INIT
        bool "YT8531DC-CA RGMII PHY chip-specific init"
        depends on MINIHUB_NET_ETH && IDF_TARGET_ESP32S31
        default y
        help
            Motorcomm YT8531DC-CA on ESP32-S31 Function CoreBoard.
            Re-enable auto-negotiation after reset and set RGMII Tx/Rx delays
            (same sequence as IDF examples/ethernet/basic).

endmenu
