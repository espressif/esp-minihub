# ESP-IDF build outputs (any app / depth)
build/
build_*/
managed_components/
dependencies.lock

# Board-manager generated codes (idf.py bmgr); per-product, not Core
application/*/components/gen_bmgr_codes/

# IDF-generated Kconfig results only (not configs/sdkconfig/ source trees)
/sdkconfig
/sdkconfig.old
application/*/sdkconfig
application/*/sdkconfig.old
application/*/sdkconfig.bak
*.bak

# Optional local IDF checkout / symlink at repo root
/esp-idf/

# MiniHub compose / local machine
cmake/generated/
.minihub_app
.minihub_profile
.minihub_env
ci_artifacts/

# Lab-only sdkconfig fragments (copy from *.example)
**/configs/sdkconfig/local.overrides

# Tooling / OS
__pycache__/
*.py[cod]
*.host.o
.DS_Store
*.code-workspace

# Agent workspace (Cursor / CodeBuddy / Qwen / Qoder share one rule set).
# .agent/skills/ and .agent/mcp/ are the shared, versioned artifacts;
# .agent/private/ is process (handoffs, plans, reviews, memory, probes),
# kept local and exported to its own system.
.agent/private/
.codebuddy/
.superpowers
.workbuddy/

# Docs (esp-docs)
.venv-docs/
docs/_build/
/_build/
# Staged by docs/_extensions/stage_catalog.py at Sphinx configure time
docs/_static/catalog/
docs/_static/architecture/
docs/_static/data_model/
docs/_static/data_flow/
docs/_static/rules/
docs/_static/ota_update/
docs/_static/net_boot/
docs/_static/source_tree/
docs/_static/catalog.zip
docs/_static/module_sdk.zip

# Local design notes (keep on disk; do not commit)
docs/superpowers/

# Store pack artifacts (build locally / deploy outside the tree)
*.mhub

# Local git worktrees
.worktrees/
