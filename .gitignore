# ESP-IDF build outputs (any app / depth)
build/
managed_components/
dependencies.lock

# Board-manager generated codes (idf.py bmgr); per-product, not Core
application/*/components/gen_bmgr_codes/

# IDF-generated Kconfig results only (not config/sdkconfig/ source trees)
/sdkconfig
/sdkconfig.old
application/*/sdkconfig
application/*/sdkconfig.old
application/*/sdkconfig.bak
*.bak

# Optional local IDF checkout / symlink at repo root
/esp-idf/

# MiniHub compose / local machine
cmake/generated/
.minihub_app
.minihub_profile
.minihub_env
ci_artifacts/

# Lab-only sdkconfig fragments (copy from *.example)
**/config/sdkconfig/local.overrides

# Tooling / OS
__pycache__/
*.py[cod]
*.host.o
.DS_Store
*.code-workspace

# Local IDE / CodeBuddy session notes
.codebuddy/memory/
.workbuddy/

# Docs (esp-docs)
.venv-docs/
docs/_build/
/_build/
# Staged by docs/_extensions/stage_catalog.py at Sphinx configure time
docs/_static/catalog/
docs/_static/catalog.zip
docs/_static/module_sdk.zip

# Local design notes (keep on disk; do not commit)
docs/superpowers/
