#!/usr/bin/env bash
# Strip Cursor attribution trailers from commit messages (MiniHub policy).
set -euo pipefail
msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi
tmp="$(mktemp)"
grep -v -E '^[[:space:]]*(Co-authored-by:[[:space:]]*Cursor|Made-with:[[:space:]]*Cursor)' "$msg_file" \
  | awk 'NF{p=1} p' \
  | awk 'BEGIN{b=0} {if(NF==0){b++}else{for(i=0;i<b;i++)print ""; b=0; print}}' \
  > "$tmp"
mv "$tmp" "$msg_file"
