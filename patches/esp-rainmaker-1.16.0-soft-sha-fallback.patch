From: MiniHub Contributors
Subject: esp-rainmaker: software SHA-256 when HW SHA is disabled

esp_sha() is only linked when CONFIG_MBEDTLS_HARDWARE_SHA=y. Korvo1
disables HW SHA/AES (GDMA hang with RGB panel). Fall back to mbedtls_md
/ mbedtls_sha256 so node_auth still links.

Component: espressif/esp-rainmaker v1.16.0 (commit afda50d)
File: components/esp_rainmaker/src/core/esp_rmaker_node_auth.c
Apply-Root: application/minihub/components/esp-rainmaker

Apply: ./tools/apply_component_patches.sh
---
--- a/components/esp_rainmaker/src/core/esp_rmaker_node_auth.c
+++ b/components/esp_rainmaker/src/core/esp_rmaker_node_auth.c
@@ -25,13 +25,15 @@
 #include "mbedtls/ecdsa.h"
 #include "ecdsa/ecdsa_alt.h"
 #endif
-/* esp_sha() lives in the mbedtls port on all IDF versions, but its public header
- * was renamed: sha_core.h on v6.0, sha_parallel_engine.h on older IDF. */
+/* esp_sha() is only linked when CONFIG_MBEDTLS_HARDWARE_SHA=y. Builds that
+ * force software crypto (e.g. Korvo1: GDMA + HW SHA hang) must use mbedtls_md. */
+#if defined(CONFIG_MBEDTLS_HARDWARE_SHA) && CONFIG_MBEDTLS_HARDWARE_SHA
 #if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(6, 0, 0)
 #include "sha/sha_core.h"
 #else
 #include "sha/sha_parallel_engine.h"
 #endif
+#endif
 #include "soc/soc_caps.h"
 
 /* The TEST_SIGNATURE_VERIFICATION debug aid still uses mbedtls_pk_get_type() and
@@ -109,10 +111,25 @@ esp_err_t esp_rmaker_node_auth_sign_msg(const void *challenge, size_t inlen, voi
         return ESP_ERR_INVALID_ARG;
     }
 
-    /* Calculate SHA-256 of challenge. esp_sha() is available on all supported
-     * IDF versions (mbedtls port), so no version split is needed here. */
+    /* Calculate SHA-256 of challenge. Prefer esp_sha() when HW SHA is enabled;
+     * otherwise use mbedtls (esp_sha.o is not built without HARDWARE_SHA). */
     uint8_t hash[32] = {0};
+#if defined(CONFIG_MBEDTLS_HARDWARE_SHA) && CONFIG_MBEDTLS_HARDWARE_SHA
     esp_sha(SHA2_256, (const unsigned char *)challenge, inlen, hash);
+#else
+#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(6, 0, 0)
+    if (mbedtls_md(mbedtls_md_info_from_type(MBEDTLS_MD_SHA256),
+                   (const unsigned char *)challenge, inlen, hash) != 0) {
+        ESP_LOGE(TAG, "SHA-256 failed");
+        return ESP_FAIL;
+    }
+#else
+    if (mbedtls_sha256((const unsigned char *)challenge, inlen, hash, 0) != 0) {
+        ESP_LOGE(TAG, "SHA-256 failed");
+        return ESP_FAIL;
+    }
+#endif
+#endif
 
     /* Sign the hash using ECDSA or RSA */
     mbedtls_pk_init(&pk_ctx);
