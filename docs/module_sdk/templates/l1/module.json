{
  "id": "PLACEHOLDER_ID",
  "name": "PLACEHOLDER_NAME",
  "version": "0.1.0",
  "targets": ["esp32s31"],
  "enabled": true,
  "type": "pack",
  "runtime": "pack",
  "description": "L1 pack: inject demo MQTT device (Host mqtt adapter must be enabled).",
  "inject": {
    "adapter": "mqtt",
    "devices": [
      {
        "point_id": "mqtt.PLACEHOLDER_ID_demo",
        "type": "switch",
        "state_topic": "minihub/PLACEHOLDER_ID/state",
        "command_topic": "minihub/PLACEHOLDER_ID/set"
      }
    ]
  }
}
