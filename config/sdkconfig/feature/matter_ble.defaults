# Matter BLE controller on ESP32-S31
CONFIG_ENABLE_ESP32_BLE_CONTROLLER=y
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=n

# Commissioner is BLE central (CHIPoBLE write/discover). claw_minihub
# sdkconfig.defaults turns these off for peripheral-only; override when Matter on.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
