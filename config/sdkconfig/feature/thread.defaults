#
# OpenThread Border Router (native 802.15.4). Mutex with zigbee stack at build time.

CONFIG_MINIHUB_THREAD_ADAPTER=y

CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_BORDER_ROUTER=y
CONFIG_OPENTHREAD_RADIO_NATIVE=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_TASK_SIZE=8192
# CONFIG_OPENTHREAD_CLI is not set

CONFIG_MBEDTLS_CMAC_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y

CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=12
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_LWIP_NETIF_STATUS_CALLBACK=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y

CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_MDNS_MULTIPLE_INSTANCE=y

# FindOperational after Thread join must use platform DnssdImpl →
# OpenThread DNS client against local SRP/DNS-SD (ML-EID:53).
# chip_mdns=minimal queries backbone UDP mDNS and never sees Thread-only
# SRP hosts even when BR logs "Host update" / "Add new service".
# CONFIG_USE_MINIMAL_MDNS is not set

# BR remains SRP server (OT FTD). Also enable SRP client so CHIP platform
# DnssdImpl can Init/Resolve via OpenThread DNS against the local SRP DB.
CONFIG_OPENTHREAD_SRP_CLIENT=y

# OT stack lifecycle is minihub_thread, not esp_matter::start().
# CONFIG_ESP_MATTER_ENABLE_OPENTHREAD is not set
