# MiniHub shared memory — align with MiniHub application/claw_minihub/sdkconfig
# Soft crypto: RGB LCD GDMA + hardware SHA/AES DMA can hang (sha_hal_wait_idle).
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# CONFIG_ESPTOOLPY_NO_STUB is not set
# CONFIG_ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
# Do not put .bss in PSRAM on S31 XIP: flash_rodata_seg and ext_ram_seg share
# drom. CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY emits .ext_ram.dummy which
# then rewinds the location counter past .flash.rodata_noload (ld: "cannot
# move location counter backwards"). Keep NOINIT internal as well.
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
# CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY is not set
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# Wi-Fi DMA buffers must fit internal DRAM (claw_minihub/sdkconfig values).
# Default 16/32 static/dynamic RX OOMs under XIP + Zigbee + BTDM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=3
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_WIFI_RMT_STATIC_TX_BUFFER_NUM=8
CONFIG_WIFI_RMT_CACHE_TX_BUFFER_NUM=32
CONFIG_WIFI_RMT_RX_BA_WIN=3
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# DEFAULT respects SPIRAM_MALLOC_ALWAYSINTERNAL (unlike STRATEGY_SPIRAM)
CONFIG_LITTLEFS_MALLOC_STRATEGY_DEFAULT=y
# CONFIG_LITTLEFS_MALLOC_STRATEGY_INTERNAL is not set
# CONFIG_LITTLEFS_MALLOC_STRATEGY_SPIRAM is not set
# CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM is not set
# CONFIG_MDNS_MEMORY_ALLOC_INTERNAL is not set
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# CONFIG_MDNS_TASK_CREATE_FROM_INTERNAL is not set
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
