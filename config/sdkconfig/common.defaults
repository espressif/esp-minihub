# MiniHub common Host defaults (target-neutral)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
# CONFIG_ESP_HTTP_CLIENT_SAVE_RESPONSE_HEADERS is not set
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_MINIHUB_WEB_UI=y
CONFIG_MINIHUB_MODULE_THIRD_PARTY_UI_WEB=y
CONFIG_MINIHUB_POINT_DEBOUNCE_MS=1000
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_LWIP_MAX_SOCKETS=50
