#
# Claw S31: Wi-Fi/net80211 .bss in PSRAM breaks after FAT/flash (cache off).
# Must win over repo config/sdkconfig/memory.defaults (BSS external=y).
# See sdkconfig.defaults.claw_board and boards/.../korvo1/sdkconfig.defaults.board.

CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=n
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=n
# CONFIG_ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY is not set
