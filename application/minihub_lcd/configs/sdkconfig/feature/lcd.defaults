#
# LCD UI (esp-brookesia / LVGL). Mutually exclusive with Ethernet.
# Pair with feature/wifi_sta (or other net) and feature/partitions_16m.
# This product uses application/minihub_lcd/partitions.csv.

CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_MINIHUB_LCD_UI=y
# brookesia_hal_adaptor gates src/display/*.cpp (lcd_panel_impl.cpp) on this.
# Without it the image links but has no PanelIface for select_output().
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_DISPLAY_DEVICE=y
# ...and the two implementations behind it. LEDC backlight is intentionally
# absent: this board declares no dev_ledc_ctrl device.
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_ENABLE_LCD_PANEL_IMPL=y
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_LCD_PANEL_H_RES=800
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_LCD_PANEL_V_RES=480
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_ENABLE_LCD_TOUCH_IMPL=y
CONFIG_MINIHUB_LCD_UI_REFRESH_MS=30000
# CONFIG_MINIHUB_NET_ETH is not set
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_FREETYPE_USE_LVGL_PORT=y
CONFIG_MINIHUB_WEB_UI=y
CONFIG_MINIHUB_DEV_FS_UPLOAD=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_BROOKESIA_GUI_INTERFACE_ENABLE_EXAMPLES is not set
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DPI_DEF=60
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FS_STDIO_LETTER=65
CONFIG_LV_FS_POSIX_LETTER=65
CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=65
CONFIG_LV_USE_LODEPNG=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FREETYPE=y
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK=y
CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK=y
# CONFIG_LV_FONT_UNSCII_8 is not set
# CONFIG_LV_FONT_DEFAULT_UNSCII_8 is not set
CONFIG_BROOKESIA_UTILS_THREAD_PROFILER_ENABLE_FREERTOS_CONFIG=y
CONFIG_MINIHUB_STORAGE_MIN_FREE_BYTES=262144
# brookesia/LVGL global constructors and the LCD bring-up run on the main task;
# the 3.5 KiB default overflows it. Give the LCD variant a 24 KiB main stack
# (internal RAM). The default product keeps its smaller stack.
CONFIG_MAIN_TASK_STACK_SIZE=24576
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
