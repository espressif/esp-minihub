# RTSP H.265 recorder: prepared (segment length, relay) and OFF, since it records to
# the USB stick and pulls a live camera stream. Enable with MINIHUB_USB_MSC on a board
# that has both, then set the stream URL at runtime.
CONFIG_MINIHUB_RTSP_CAM=n
# CONFIG_MINIHUB_RTSP_CAM_AUTO_START is not set
CONFIG_MINIHUB_RTSP_CAM_DEFAULT_SEGMENT_SEC=600
