# Wi-Fi BLE provisioning; release BTDM after provision
CONFIG_MINIHUB_WIFI_PROVISIONING=y
CONFIG_MINIHUB_WIFI_PROV_TRANSPORT_BLE=y
# CONFIG_MINIHUB_WIFI_PROV_TRANSPORT_SOFTAP is not set
CONFIG_MINIHUB_WIFI_PROV_BLE_FREE_BTDM=y
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
