# RainMaker bridge
CONFIG_MINIHUB_RAINMAKER=y
CONFIG_ESP_RMAKER_SELF_CLAIM=y
# CONFIG_ESP_RMAKER_ASSISTED_CLAIM is not set
CONFIG_ESP_RMAKER_ENABLE_CHALLENGE_RESPONSE=y
CONFIG_ESP_RMAKER_ON_NETWORK_CHAL_RESP_ENABLE=y
# CONFIG_ESP_RMAKER_LOCAL_CTRL_FEATURE_ENABLE is not set
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_0=y
