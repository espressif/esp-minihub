#
# LCD UI (esp-brookesia / LVGL). Mutually exclusive with Ethernet.
# Pair with feature/wifi_sta (or other net) and feature/partitions_16m.

CONFIG_MINIHUB_LCD_UI=y
CONFIG_MINIHUB_LCD_UI_REFRESH_MS=4000
# CONFIG_MINIHUB_NET_ETH is not set
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FREETYPE_USE_LVGL_PORT=y
CONFIG_MINIHUB_WEB_UI=y
CONFIG_MINIHUB_DEV_FS_UPLOAD=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_BROOKESIA_GUI_INTERFACE_ENABLE_EXAMPLES is not set
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FS=y
CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_TXT_ENC_UTF8=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_DPI_DEF=60
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FS_STDIO_LETTER=65
CONFIG_LV_FS_POSIX_LETTER=65
CONFIG_LV_FS_DEFAULT_DRIVER_LETTER=65
CONFIG_LV_USE_LODEPNG=y
CONFIG_ESP_LVGL_ADAPTER_ENABLE_FREETYPE=y
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK is not set
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_16_CJK is not set
# CONFIG_LV_FONT_UNSCII_8 is not set
# CONFIG_LV_FONT_DEFAULT_UNSCII_8 is not set
CONFIG_BROOKESIA_UTILS_THREAD_PROFILER_ENABLE_FREERTOS_CONFIG=y
