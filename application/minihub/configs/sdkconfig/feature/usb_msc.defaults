# USB Host MSC plumbing: the FATFS/VFS/USB-host sizing this feature needs, and the
# switch itself left OFF, because the connector is board-specific. Enable it per
# product (or in local.overrides) once the hardware has a USB-OTG host socket.
CONFIG_MINIHUB_USB_MSC=y
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_FATFS_VOLUME_COUNT=2
# CONFIG_FATFS_LFN_NONE is not set
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
# CONFIG_FATFS_SECTOR_512 is not set
CONFIG_FATFS_SECTOR_4096=y
# CONFIG_FATFS_PER_FILE_CACHE is not set
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
# CONFIG_FATFS_ALLOC_PREFER_ALIGNED_WORK_BUFFERS is not set
CONFIG_FATFS_FS_LOCK=2
CONFIG_VFS_MAX_COUNT=12
