{
  "id": "ble_mesh_pack",
  "name": "BLE Mesh L1 defaults (demo)",
  "version": "0.1.0",
  "targets": ["esp32s31"],
  "requires": ["BLE_mesh"],
  "enabled": true,
  "type": "pack",
  "runtime": "pack",
  "description": "L1 config pack: merge extra BLE Mesh bind_models into the Host adapter. No main.js, no .so, no radio devices[].",
  "inject": {
    "adapter": "ble_mesh",
    "provision": {
      "bind_models": [
        {
          "model_id": "0xFF01",
          "name": "l1_demo_vendor_model"
        }
      ]
    }
  }
}
