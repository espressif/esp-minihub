    rsource "../../components/minihub_zigbee/Kconfig.minihub"
    rsource "../../components/minihub_protocol_adapters/adapter_modbus/Kconfig.minihub"
    rsource "../../components/minihub_protocol_adapters/adapter_mqtt/Kconfig.minihub"

endmenu
