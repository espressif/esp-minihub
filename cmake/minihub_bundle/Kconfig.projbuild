# Top-level MiniHub menu. Fragment files are Kconfig.minihub (not named
# Kconfig) so IDF does not also mount them at the project root.
# This file is auto-loaded when minihub_bundle is in the build graph.
menu "MiniHub"

    config MINIHUB_VERSION
        string "Version (firmware / product / OTA)"
        default "0.1.0"
        help
            Single version for the device: reported by the firmware as
            firmware_version (OTA comparison), used by tools/deploy.sh as the
            Firmwares/<chip>/<version>/ folder name, and shown in the Web
            sidebar / system page as v<version>. This is not the git describe
            string; that is reported separately as the commit line.

    rsource "../../components/minihub_core/Kconfig.minihub"
    rsource "../../components/minihub_auth/Kconfig.minihub"
    rsource "../../components/minihub_ble_mesh/Kconfig.minihub"
    rsource "../../components/minihub_hub/Kconfig.minihub"
    rsource "../../components/minihub_js/Kconfig.minihub"
    rsource "../../components/minihub_lcd/Kconfig.minihub"
    rsource "../../components/minihub_matter/Kconfig.minihub"
    rsource "../../components/minihub_mcp_server/Kconfig.minihub"
    rsource "../../components/minihub_module/Kconfig.minihub"
    rsource "../../components/minihub_mqtt_broker/Kconfig.minihub"
    rsource "../../components/minihub_net/Kconfig.minihub"
    rsource "../../components/minihub_provision/Kconfig.minihub"
    rsource "../../components/minihub_rainmaker/Kconfig.minihub"
    rsource "../../components/minihub_rtsp_cam/Kconfig.minihub"
    rsource "../../components/minihub_store/Kconfig.minihub"
    rsource "../../components/minihub_thread/Kconfig.minihub"
    rsource "../../components/minihub_usb_msc/Kconfig.minihub"
